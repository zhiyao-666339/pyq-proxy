# 复制为 .env 并填好，再 `systemctl` 或 `docker --env-file` 使用
# 必填
ZHIPU_API_KEY=你的智谱开放平台Key

# 强烈建议：账号 token 签名密钥（随机 32 字节十六进制即可）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 可选：AI 代理访问口令。留空时任何拿到地址的人都能调用 AI；
# 用户登录云账号后会自动携带身份 token，因此公网部署可不设置此项。
PROXY_TOKEN=

# 可选：只允许你的站点跨域访问，例如 https://你的域名
ALLOW_ORIGIN=*

# 数据目录（账号、资料、画像、备份）
DATA_DIR=./data

PORT=8787

# 可选：飞书自建应用（Koyeb 免费版必填：无持久卷，靠飞书保存账号数据）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# auto：配置飞书后同时作为持久存储（每次保存防抖上传、启动时自动恢复）
# off：只用本地磁盘（适合有持久卷的服务器）
REMOTE_STORE=auto

# 每个账号保留最近多少份飞书存档
REMOTE_KEEP=14

# 可选：手动触发每日任务的运维口令（POST /admin/daily + X-Admin-Token）
ADMIN_TOKEN=
