server {
    listen 80;
    server_name pyq.yourdomain.com;
    # 强制 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pyq.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/pyq.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pyq.yourdomain.com/privkey.pem;

    # 24MB 上限：够传一张高清 base64 图片做云审
    client_max_body_size 24m;

    # 长轮询（视频生成任务可能等 3 分钟）
    proxy_read_timeout      240s;
    proxy_send_timeout      240s;
    proxy_connect_timeout   10s;

    # 转发真实 IP（代理层本身不记录日志，Node 代码里也没打日志，可忽略）
    proxy_set_header        Host              $host;
    proxy_set_header        X-Real-IP         $remote_addr;
    proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header        X-Forwarded-Proto $scheme;

    # CORS：浏览器会在第一次 POST 前先发 OPTIONS 预检，直接放行
    add_header Access-Control-Allow-Origin      "$http_origin" always;
    add_header Access-Control-Allow-Methods     "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers     "Content-Type, Authorization, X-Pyq-Token" always;
    add_header Access-Control-Allow-Credentials "true" always;

    if ($request_method = OPTIONS) {
        add_header Access-Control-Max-Age 86400 always;
        return 204;
    }

    # 简单 IP 白名单（可选，公网部署强烈建议开）
    # allow  10.0.0.0/8;
    # deny   all;

    location / {
        proxy_pass http://127.0.0.1:8787;
    }
}
